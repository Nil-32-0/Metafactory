		{
			dependencies: ["241CE7D5D474CF73"]
			description: [
				"While not as good as the Bender, the Forge Hammer has some other uses that the Hammer would normally be used for and so you should make one. Once you have both, you should only need your hammer for breaking machines and configuring output sides."
				""
				"Another side benefit the Forge Hammer can offer is crushing ores faster than a macerator, with the downside of losing any byproducts or increase in count the macerator might have made."
			]
			id: "13C8D2BA8523FC9F"
			subtitle: "Tool Replacement"
			tasks: [{
				id: "28307D8E6D3F8A45"
				item: "gtceu:lv_forge_hammer"
				type: "item"
			}]
			title: "The Other Superior Hammer"
			x: 1.5d
			y: 8.5d
		}
		{
			dependencies: ["2FA18A0CDDBB4796"]
			description: ["Primarily used to make bolts from rods, the cutter takes some fluid as a lubricant but produces twice the output as a saw."]
			id: "30184AFF50D733FD"
			subtitle: "Tool Replacement"
			tasks: [{
				id: "680D0ACD4C519304"
